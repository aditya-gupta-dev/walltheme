{
  "name": "walltheme-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/vscode"
  ],
  "scripts": {
    "compile": "bun run --cwd packages/vscode compile",
    "watch": "bun run --cwd packages/vscode watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check": "bun run typecheck && bun run test",
    "package": "bun install --frozen-lockfile && bun run --cwd packages/vscode package",
    "publish": "bun run --cwd packages/vscode publish",
    "compile:zed": "cargo build --manifest-path packages/zed/Cargo.toml --target wasm32-wasip2 --release --locked",
    "check:zed": "cargo fmt --manifest-path packages/zed/Cargo.toml --check && cargo check --manifest-path packages/zed/Cargo.toml --target wasm32-wasip2 --locked"
  },
  "devDependencies": {
    "@types/bun": "^1.1.10",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "1.84.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.7.0",
    "yauzl": "3.4.0",
    "@walltheme/core": "workspace:*",
    "pngjs": "^7.0.0",
    "utif": "^3.1.0"
  }
}
